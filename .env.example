# Compose-only settings. Keep secret values out of this file; these point to
# root-readable files created according to infra/secrets/README.md.
COMPOSE_PROJECT_NAME=romanpics
ROMANPICS_IMAGE_TAG=local
ROMANPICS_EDGE_NETWORK=romanpics-edge
ROMANPICS_PREVIEW_VOLUME=romanpics-previews
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
POSTGRES_DB=romanpics
# The bootstrap default intentionally retains compatibility with volumes
# initialized by the original single-role Compose stack.
POSTGRES_BOOTSTRAP_USER=romanpics
POSTGRES_MIGRATION_USER=romanpics_migrator
POSTGRES_API_USER=romanpics_api
POSTGRES_WORKER_USER=romanpics_worker
POSTGRES_BOOTSTRAP_PASSWORD_FILE=/etc/romanpics/secrets/postgres_bootstrap_password
POSTGRES_MIGRATION_PASSWORD_FILE=/etc/romanpics/secrets/postgres_migration_password
POSTGRES_API_PASSWORD_FILE=/etc/romanpics/secrets/postgres_api_password
POSTGRES_WORKER_PASSWORD_FILE=/etc/romanpics/secrets/postgres_worker_password
VISITOR_SIGNING_SECRET_FILE=/etc/romanpics/secrets/visitor_signing_secret
PREVIEW_PUBLIC_BASE_URL=https://api.romanpics.example.org/previews
WORKER_POLL_INTERVAL=1
WORKER_HEARTBEAT_INTERVAL=30
WORKER_STALE_LEASE_SECONDS=300
# Default 64 MiB. Raise deliberately for a reviewed L3 product, never L1/L2.
WORKER_MAX_DOWNLOAD_BYTES=67108864

# Frontend build-time settings. NEXT_PUBLIC_API_BASE is an origin or path
# prefix without /v1; lib/api.ts appends /v1. Rebuild after changing these.
NEXT_PUBLIC_SITE_URL=https://romanpics.example.org
NEXT_PUBLIC_API_BASE=https://api.romanpics.example.org
# Absolute origin used by server-rendered frontend requests. On a hosted
# frontend this can equal NEXT_PUBLIC_API_BASE; inside one Compose network it
# may instead be http://romanpics-api:8000.
ROMANPICS_INTERNAL_API_BASE=https://api.romanpics.example.org

# FastAPI Settings fields (environment variable names are case-insensitive).
# DATABASE_URL and VISITOR_SIGNING_SECRET are assembled/read from Docker secret
# files by compose.yaml; set them directly only when running outside Compose.
APP_NAME=RomanPics API
ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://romanpics_api:URL_SAFE_PASSWORD@postgres:5432/romanpics
# VISITOR_SIGNING_SECRET=use-the-secret-file-in-production
PUBLIC_BASE_URL=https://romanpics.example.org
ALLOWED_ORIGINS=https://romanpics.example.org
COOKIE_NAME=romanpics_visitor
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_MAX_AGE_SECONDS=31536000
MANIFEST_PATH=/catalog/catalog.json
MAST_FIXTURE_ENABLED=false
MAX_SYNC_PAGES=25
RATE_LIMIT_VOTES_PER_MINUTE=30
LINK_CHECK_TIMEOUT_SECONDS=10
ALLOWED_UPSTREAM_HOSTS=images.nasa.gov,images-api.nasa.gov,images-assets.nasa.gov,svs.gsfc.nasa.gov,archive.stsci.edu,mast.stsci.edu,irsa.ipac.caltech.edu,roman.ipac.caltech.edu
