# This file is included inside the existing Dockerized Nginx `http` block.
# Replace both occurrences of api.romanpics.example.org before copying it to
# /home/saejin/projects/website/nginx/conf.d/romanpics-api.conf. The existing
# nginx.conf already supplies Docker DNS via resolver 127.0.0.11.

limit_req_zone $binary_remote_addr zone=romanpics_vote_mutations:10m rate=20r/m;

server {
    listen 80;
    listen [::]:80;
    server_name api.romanpics.example.org;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.romanpics.example.org;

    ssl_certificate /etc/letsencrypt/live/api.romanpics.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.romanpics.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_tokens off;
    client_max_body_size 64k;

    # A variable keeps Nginx bootable while the separately managed API stack is
    # stopped. `romanpics-api` is an alias on the shared external edge network.
    set $romanpics_api_upstream romanpics-api:8000;

    location ^~ /previews/ {
        alias /var/www/romanpics-previews/;
        autoindex off;
        limit_except GET { deny all; }
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location ^~ /v1/me/votes/ {
        limit_req zone=romanpics_vote_mutations burst=8 nodelay;
        include /etc/nginx/conf.d/romanpics-proxy-headers.inc;
        proxy_pass http://$romanpics_api_upstream;
    }

    # Optional same-origin alias. The static frontend may use an API origin
    # directly (/v1) or set NEXT_PUBLIC_API_BASE to an origin ending in /api.
    location ^~ /api/v1/me/votes/ {
        limit_req zone=romanpics_vote_mutations burst=8 nodelay;
        rewrite ^/api/(.*)$ /$1 break;
        include /etc/nginx/conf.d/romanpics-proxy-headers.inc;
        proxy_pass http://$romanpics_api_upstream;
    }

    location ^~ /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        include /etc/nginx/conf.d/romanpics-proxy-headers.inc;
        proxy_pass http://$romanpics_api_upstream;
    }

    location / {
        include /etc/nginx/conf.d/romanpics-proxy-headers.inc;
        proxy_pass http://$romanpics_api_upstream;
    }

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
}
