{
  "name": "romanpics",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "lint:api": "redocly lint docs/openapi.yaml",
    "api:contract": "node scripts/check-openapi-drift.mjs",
    "catalog:check": "node scripts/check-catalog.mjs",
    "catalog:links": "node scripts/check-catalog.mjs --links",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run catalog:check && npm run lint:api && npm run api:contract && npm run build",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.40.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260904.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@redocly/cli": "2.51.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "undici": "7.29.0"
  },
  "type": "module"
}
